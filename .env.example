# PostgreSQL used by the app at runtime. On Neon, use the *pooled* connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinora?schema=public"
# Optional: direct (non-pooled) connection for `prisma migrate`. On Neon, the host without "-pooler".
# DIRECT_URL="postgresql://..."

# Optional: public URL used for Open Graph links (Vercel's production URL is used automatically)
# NEXT_PUBLIC_APP_URL="https://clinora.example.com"

# Integration/E2E tests run against a separate database
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinora_test?schema=public"

# Clerk — https://dashboard.clerk.com → your app → API keys
# Publishable key starts with "pk_test_", secret key with "sk_test_".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk → Webhooks → your endpoint → Signing secret (starts with "whsec_")
CLERK_WEBHOOK_SECRET=

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
