// Clinora AI — application data model.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A public waitlist sign-up from the marketing page.
model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Local mirror of a Clerk user. Clerk owns authentication;
/// this table is the product's source of truth for account data.
model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  signedUpAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
