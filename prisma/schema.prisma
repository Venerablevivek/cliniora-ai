// Clinora AI — application data model.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A public waitlist sign-up from the marketing page.
model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  /// Public code used in this person's invite link (`/?ref=CODE`). Generated by the database,
  /// so existing rows are backfilled and older app versions keep working during a deploy.
  referralCode  String          @unique @default(dbgenerated("upper(substr(md5(((random())::text || (clock_timestamp())::text)), 1, 8))"))
  /// Who invited this person, if anyone. Kept (as null) if the referrer is ever removed.
  referredById  String?
  referredBy    WaitlistEntry?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     WaitlistEntry[] @relation("Referrals")
  /// Denormalized count of successful referrals, incremented in the same transaction as the
  /// referred sign-up. Drives the queue order: more referrals first, then earliest sign-up.
  referralCount Int             @default(0)

  @@index([referralCount, createdAt])
  @@index([referredById])
}

enum Locale {
  en
  ar
}

/// Local mirror of a Clerk user. Clerk owns authentication;
/// this table is the product's source of truth for account data.
model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  signedUpAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Preferred UI language, saved when the user switches language while signed in.
  /// Null until they've expressed (or we've seeded) a preference.
  locale      Locale?
}
